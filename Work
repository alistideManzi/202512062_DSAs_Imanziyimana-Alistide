Q3 Create function  that compute Fibonacci series using recursion
#include <iostream>
Using namespace std;
Int fibonacci(int n) {
    If (n == 0)
        Return 0;
    Else if (n == 1)
        Return 1;
    Else
        Return fibonacci(n – 1) + fibonacci(n – 2);
}

Int main() {
    Int n;

    Cout << “Enter number of terms: “;
    Cin >> n;

    Cout << “Fibonacci Series: “;

    For (int I = 0; I < n; i++) {
        Cout << fibonacci(i) << “ “;
    }

    Return 0;
}
