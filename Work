Q6  What is recursive Algorithms provide example using factorial implementation

Arecursive algorithm is a method where a function solves a problem by calling itself with smaller versions of the same problem until it reaches a base case (a stopping condition).

#include <iostream>
Using namespace std;
Int factorial(int n) {
    // Base case
    If (n == 0 || n == 1) {
        Return 1;
    }
    Return n * factorial(n – 1);
}

Int main() {
    Int num;

    Cout << “Enter a number: “;
    Cin >> num;
    Cout << “Factorial of “ << num << “ is “ << factorial(num) << endl;

    Return 0;
}


